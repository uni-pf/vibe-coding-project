# 本地环境变量与密钥 —— 永远不要提交
.env
.env.local
.env.*.local

# 依赖目录
node_modules/

# 构建产物 —— 由 npm run build 生成，源码才是要提交的东西
dist/

# 本地 AI 助手的记忆与配置 —— 属于本机工作记录，不是项目源码
# 写法是 .workbuddy/* 而不是 .workbuddy/：Git 的规则是"父目录被排除后，
# 里面的子项再也加不回来"。所以这里忽略目录内容、保留目录本身，
# 才能在下一行把 skills 单独放行。
.workbuddy/*
# 例外：Skill 是要跟着仓库走的检查标准，不是本机记录；记忆文件仍然忽略
!.workbuddy/skills/

# Python 虚拟环境与缓存
.venv/
venv/
__pycache__/

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log

# ------------------------------------------------------------
# 大体积素材：不进仓库（公开仓库一旦提交就永久留在历史里）
# ------------------------------------------------------------
# Tripo 导出的原始模型，仅作结构参考
wind-from-sea-source.blend
wind-from-sea-source.blend1
# 已被否定的旧网页模型，页面不再加载
public/wind-window.glb
# Blender 自动备份与离线渲染检查图，需要时本地重新导出
art/*.blend1
art/sea-wind-oblique-check.png
art/sea-wind-straight-check.png
art/sea-wind-still-preview.png
